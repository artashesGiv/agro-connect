# Скопируйте в .env (он в .gitignore).
# Значения не секретные: publishable key рассчитан на мобильный клиент и всё
# равно попадает в бандл APK. Секретные ключи (service_role) на фронт не кладём.
EXPO_PUBLIC_SUPABASE_URL=https://kavlgpfxxvicqhzcgspa.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_3SOVmNqjiszNTrrpLnX6Jw_AaY0VQ9K

# Ключ MapGL JS API 2GIS для вкладки «Карта». Здесь плейсхолдер: в отличие от
# publishable key Supabase, этот ключ ничем не прикрыт — любой, кто возьмёт его
# из репозитория, потратит месячный лимит запросов. Свой ключ заводится в
# Platform Manager: https://dev.2gis.com (демо-ключ живёт около месяца).
EXPO_PUBLIC_2GIS_MAPGL_KEY=your-mapgl-key
